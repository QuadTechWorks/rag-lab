# Copy to .env and fill in keys as each phase is built.
# Phase 1 (Ingestion) requires NO API keys — all loaders are local file parsers.

# ── Phase 3: Embedding ────────────────────────────────────────────────────────
OPENAI_API_KEY=
COHERE_API_KEY=
HF_API_TOKEN=              # HuggingFace Inference API (free tier)
VOYAGEAI_API_KEY=

# ── Phase 4: Vector DB ────────────────────────────────────────────────────────
PINECONE_API_KEY=
QDRANT_API_KEY=
QDRANT_URL=
WEAVIATE_API_KEY=
WEAVIATE_URL=

# ── Phase 6: Reranker ─────────────────────────────────────────────────────────
# (reuses COHERE_API_KEY above)

# ── Phase 7: Inference ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# (reuses OPENAI_API_KEY above)
